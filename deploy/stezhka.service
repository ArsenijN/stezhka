# /etc/systemd/system/stezhka.service
#
#   sudo useradd --system --home /srv/stezhka --shell /usr/sbin/nologin stezhka
#   sudo -u stezhka python3 -m venv /srv/stezhka/venv
#   sudo -u stezhka /srv/stezhka/venv/bin/pip install /path/to/stezhka/server
#   sudo cp deploy/stezhka.env.example /etc/stezhka.env   # then edit
#   sudo -u stezhka env $(cat /etc/stezhka.env | xargs) /srv/stezhka/venv/bin/stezhka set-password
#   sudo systemctl enable --now stezhka
#
# Then route a subdomain or path in server_https.py to http://127.0.0.1:8470

[Unit]
Description=Stezhka ride statistics
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stezhka
Group=stezhka
EnvironmentFile=/etc/stezhka.env
ExecStart=/srv/stezhka/venv/bin/stezhka serve
Restart=on-failure
RestartSec=5

# hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/stezhka/data
ReadOnlyPaths=/srv/syncthing/stezhka-inbox
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryMax=1G

[Install]
WantedBy=multi-user.target
