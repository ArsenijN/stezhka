# /etc/systemd/system/stezhka.service
#
#   Installed and kept up to date by deploy/install.sh (run via deploy/deploy.sh).
#
# Then route a subdomain or path in server_https.py to http://127.0.0.1:8470

[Unit]
Description=Stezhka ride statistics
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stezhka
Group=stezhka
EnvironmentFile=/etc/stezhka.env
ExecStart=/srv/stezhka/venv/bin/stezhka serve
Restart=on-failure
RestartSec=5

# hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/stezhka/data
# "-" = optional: the inbox may not exist until Syncthing is set up
ReadOnlyPaths=-/srv/syncthing/stezhka-inbox
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryMax=1G

[Install]
WantedBy=multi-user.target
