# /etc/stezhka.env - Stezhka service configuration (read by systemd and stezhka-admin).
STEZHKA_DATA_DIR=/srv/stezhka/data
STEZHKA_WEB_DIR=/srv/stezhka/app/web
STEZHKA_HOST=127.0.0.1
STEZHKA_PORT=8470
STEZHKA_COOKIE_SECURE=1

# Syncthing receive-only folder with OpenTracks / GPX exports. Enable once the folder exists:
#STEZHKA_INBOX=/srv/syncthing/stezhka-inbox
#STEZHKA_INBOX_POLL_S=30

# Fall back to tiles.openfreemap.org when no local extract exists (`stezhka-admin basemap`).
# 0 = no third-party requests from the browser.
STEZHKA_BASEMAP_REMOTE=0

# DEM elevation (Copernicus via AWS Open Data) and weather (Open-Meteo, ~10 km cell only).
# 0 = no outbound requests from the server except `stezhka-admin basemap`.
STEZHKA_ENRICH=1

# AGPL-3.0 section 13: link shown to every user. Point it at your fork if you run modified code.
#STEZHKA_SOURCE_URL=https://github.com/ArsenijN/stezhka
