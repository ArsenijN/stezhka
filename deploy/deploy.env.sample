# deploy.env - local deployment settings for deploy/deploy.sh.
# Copy to deploy/deploy.env (gitignored, never synced) and fill in your values.

# --- SSH connection ---
REMOTE_USER=youruser
REMOTE_HOST=your.server.example
REMOTE_PORT=22
SSH_KEY=${HOME}/.ssh/id_ed25519

# --- Paths ---
# Where the source is staged on the server, relative to the remote user's home.
REMOTE_SRC=stezhka-src
# Local Python that has the dev dependencies (pytest) for the pre-deploy test run.
DEV_PYTHON=${HOME}/.venvs/stezhka/bin/python
